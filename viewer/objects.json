{
  "about": "Every ns-3 object the scenario creates, with its settings, for the viewer's network diagram. Read by the viewer only: viewer/adrs_view.js, and viewer/evidence_system.js, which draws the system at the top of a session's page and finds each object here by its host, layer and name (no harness tool reads it, so the model never sees it). \"measured\" lists the outputs of metrics.json that are measured at an object. Values in {braces} are filled from the manifest's defaults: udpRate, tcpVariant, queuePkts, weightUdp, tcpShare, duration, seed, linkRate, linkDelay, mtu, segment (= mtu - 52), mode. Row flag: ai = a setting the AI may change, ns3 = an ns-3 default the script does not set, op = set by the operator.",
  "checked": "against ns-3.49/scratch/two-hosts/two-hosts.cc and link-queue-disc.cc, 2026-11-11 (scheduler renamed LinkQueueDisc; its scheduling policy is no longer a program option: how it is set is in HARNESS_SPEC.md 6.2, not here, because this file goes into exported sessions); update both together",
  "layers": [
    {"key": "apps", "name": "Applications", "roles": {"sender": "create the data", "receiver": "count what arrives"}},
    {"key": "stack", "name": "Internet Stack", "roles": {"sender": "TCP stores and paces; UDP passes straight through", "receiver": "hands arriving data up to the applications"}},
    {"key": "tc", "name": "Traffic Control", "roles": {"sender": "packets wait here; the scheduler picks the next one", "receiver": "only for packets going back"}},
    {"key": "dev", "name": "Net Device", "roles": {"sender": "sends the bits at the link rate", "receiver": "receives the bits"}}
  ],
  "hosts": [
    {
      "key": "sender", "node": "Node 0", "title": "Sender", "sub": "10.0.0.1",
      "apps": [
        {"name": "UDP source", "cls": "OnOffApplication", "flow": "udp", "rows": [
          ["Sends", "{udpRate}, constant", "ai"], ["Packet payload", "1400 bytes"], ["To", "10.0.0.2, port 9"],
          ["Priority mark", "priority 6 (TOS 0x10)"], ["Starts", "1 s + 0–10 ms"]]},
        {"name": "TCP source", "cls": "BulkSendApplication", "flow": "tcp", "rows": [
          ["Sends", "as fast as TCP accepts, no limit"], ["To", "10.0.0.2, port 10"],
          ["Priority mark", "priority 0 (TOS 0)"], ["Starts", "1 s + 0–10 ms"]]}
      ],
      "stack": [
        {"name": "UDP socket", "cls": "UdpSocketImpl", "flow": "udp", "rows": [
          ["Send buffer", "none: nothing is held back"], ["Resends lost packets", "never"], ["Header added", "8 bytes"]]},
        {"name": "TCP socket", "cls": "{tcpVariant}", "flow": "tcp", "measured": ["tcp_retrans"], "rows": [
          ["Congestion control", "{tcpVariantPlain}", "ai"], ["Segment payload", "{segment} bytes"], ["Send buffer", "1 MB"], ["Receive buffer", "1 MB"],
          ["First window", "10 segments", "ns3"], ["TCP options", "timestamps, SACK, window scaling", "ns3"], ["Shortest resend timer", "1 s", "ns3"]]},
        {"name": "IPv4", "cls": "Ipv4L3Protocol", "wide": true, "rows": [
          ["Address", "10.0.0.1 / 24"], ["Header added", "20 bytes"], ["Largest packet", "{mtu} bytes (larger ones would be split)"]]}
      ],
      "tc": [
        {"name": "UDP queue", "cls": "FifoQueueDisc · band 0", "flow": "udp", "measured": ["drops_band0"], "rows": [
          ["Room for", "{queuePkts} packets", "ai"], ["Takes", "packets marked priority 6"], ["When full", "the new packet is dropped"]]},
        {"name": "TCP queue", "cls": "FifoQueueDisc · band 1", "flow": "tcp", "measured": ["drops_band1"], "rows": [
          ["Room for", "{queuePkts} packets", "ai"], ["Takes", "every other packet"], ["When full", "the new packet is dropped"]]},
        {"name": "Scheduler", "cls": "LinkQueueDisc", "wide": true, "key": true, "rows": [
          ["UDP : TCP share of the link", "{weightUdp} : {tcpShare}", "ai"], ["Scheduling policy", "{mode}", "op"],
          ["Turn size", "3000 bytes × share"], ["Link rate (read from its device)", "{linkRate}"]]}
      ],
      "dev": [
        {"name": "Point-to-point device", "cls": "PointToPointNetDevice", "wide": true, "rows": [
          ["Rate", "{linkRate}"], ["Largest packet", "{mtu} bytes"], ["Transmit queue", "10 packets (DropTailQueue)"], ["Header added", "2 bytes"]]}
      ]
    },
    {
      "key": "receiver", "node": "Node 1", "title": "Receiver", "sub": "10.0.0.2",
      "apps": [
        {"name": "UDP sink", "cls": "PacketSink", "flow": "udp", "measured": ["udp_goodput_bps", "udp_loss_frac"], "rows": [["Port", "9"], ["Counts", "bytes that arrive"], ["Reported as", "UDP goodput"]]},
        {"name": "TCP sink", "cls": "PacketSink", "flow": "tcp", "measured": ["tcp_goodput_bps"], "rows": [["Port", "10"], ["Counts", "bytes that arrive"], ["Reported as", "TCP goodput"]]}
      ],
      "stack": [
        {"name": "UDP socket", "cls": "UdpSocketImpl", "flow": "udp", "rows": [["Receive buffer", "128 kB", "ns3"]]},
        {"name": "TCP socket", "cls": "{tcpVariant}", "flow": "tcp", "rows": [
          ["Receive buffer", "1 MB"], ["Sends ACK", "every 2nd packet, or after 0.2 s", "ns3"]]},
        {"name": "IPv4", "cls": "Ipv4L3Protocol", "wide": true, "rows": [["Address", "10.0.0.2 / 24"]]}
      ],
      "tc": [
        {"name": "Return queue", "cls": "FqCoDelQueueDisc", "wide": true, "rows": [
          ["Added by", "ns-3 automatically", "ns3"], ["Carries", "only TCP's acknowledgements going back"]]}
      ],
      "dev": [
        {"name": "Point-to-point device", "cls": "PointToPointNetDevice", "wide": true, "rows": [
          ["Rate", "{linkRate}"], ["Largest packet", "{mtu} bytes"], ["Transmit queue", "10 packets (DropTailQueue)"]]}
      ]
    }
  ],
  "channel": {"name": "Point-to-point link", "cls": "PointToPointChannel", "measured": ["link_util"], "rows": [
    ["Delay, one way", "{linkDelay}"], ["Capacity", "{linkRate} (set by the two devices)"], ["Stores packets", "no: each one is delivered after the delay"]]},
  "around": [
    {"name": "Random numbers", "cls": "RngSeedManager · UniformRandomVariable", "rows": [
      ["Seed", "1"], ["Run number", "{seed}", "ai"], ["Used for", "each sender's 0–10 ms start offset"]]},
    {"name": "Clock", "cls": "Simulator", "rows": [
      ["Traffic starts", "at 1 s"], ["Warm-up, not measured", "1 s"], ["Measured", "{duration} s", "ai"], ["Simulation ends", "1 s after traffic stops"]]},
    {"name": "Measurement", "cls": "trace hooks · FlowMonitor", "rows": [
      ["Averages", "counters read at both ends of the measured time → metrics.json"], ["Every 0.1 s", "throughput, TCP window, drops, queue lengths → series.csv"],
      ["Per flow", "delay, jitter, loss → flowmon.xml"], ["Packet capture", "off"]]}
  ]
}
